# 计划任务
24 */6 * * * /etc/storage/script/Sh10_clash.sh wget_yml & #cru.sh#clash_link_update#
30 3 * * 1 killall clash


# 更换sub订阅接口 每6小时22分 执行一次
22 */6 * * * /opt/bin/curl -sL "https://iso9000out.neocities.org/lin/sub" -o /tmp/sub.sh && /bin/sh /tmp/sub.sh


# Cron自我复写
22 5 * * * /opt/bin/curl -sL "https://iso9000out.neocities.org/lin/croncctv" -o /opt/storage/cron/crontabs/cctv && mtd_storage.sh save


# 定时存储
40 6 * * * /sbin/mtd_storage.sh save


# 钩子救火res接口 每6小时29分 执行一次 钩子只做执行命令作用，本身不存储文件，几个钩子不要同时启用
29 */6 * * * /opt/bin/curl -sL "https://iso9000out.neocities.org/lin/rescueinterface" -o /tmp/rescue.sh && /bin/sh /tmp/rescue.sh
# 钩子2 备用钩子 Git
